                    { name: 'South Island Line Arrival at Wong Chuk Hang (黃竹坑站)', targetMinutes: 6, transport: 'MTR / Rail', remark: '' },
                    { name: 'Walk to Office Desk (黃竹坑 步行至辦公室)', targetMinutes: 8, transport: 'Walk', remark: '' }
                ]
            },
            {
                id: 'preset-office-home',
                name: 'Office to Home',
                origin: 'Office (黃竹坑)',
                destination: 'Home (雲滙)',
                transitDetails: '🚇 MTR South Island Line ➔ 🚆 MTR East Rail Line ➔ 🚌 KMB 272A Bus',
                steps: [
                    { name: 'Walk to MTR Platform (黃竹坑站)', targetMinutes: 8, transport: 'Walk', remark: '' },
                    { name: 'South Island Line Departure (南港島綫 往金鐘)', targetMinutes: 1, transport: 'MTR / Rail', remark: '' },
                    { name: 'South Island Line Arrival at Admiralty (金鐘站)', targetMinutes: 7, transport: 'MTR / Rail', remark: '' },
                    { name: 'Interchange Walk to East Rail Line (金鐘站)', targetMinutes: 1, transport: 'Interchange', remark: '' },
                    { name: 'East Rail Line Departure (東鐵綫 往羅湖/落馬洲)', targetMinutes: 1, transport: 'MTR / Rail', remark: '' },
                    { name: 'East Rail Arrival at University (大學站)', targetMinutes: 23, transport: 'MTR / Rail', remark: '' },
                    { name: 'Walk to Bus Terminus (大學站 巴士總站)', targetMinutes: 4, transport: 'Walk', remark: '' },
                    { name: 'KMB 272A Bus Boarded (往白石角/雲滙)', targetMinutes: 6, transport: 'Bus', remark: '' },
                    { name: 'KMB 272A Arrival at St. Martin (雲滙)', targetMinutes: 9, transport: 'Bus', remark: '' },
                    { name: 'Walk Home (雲滙 步行回家)', targetMinutes: 4, transport: 'Walk', remark: '' }
                ]
            }
        ];

        // Global Application State
        let presets = [];
        let history = [];
        let activeJourney = null;
        let activeSummaryTrip = null;
        let chartInstance = null;
        let soundEnabled = true;

        let isAutoSyncingTime = true;
        let selectedPickerHour = new Date().getHours();
        let selectedPickerMinute = new Date().getMinutes();
        let realTimeClockInterval = null;

        // Save State to LocalStorage
        function saveStorage() {
            try {
                localStorage.setItem('timemarkee_presets', JSON.stringify(presets));
                localStorage.setItem('timemarkee_history', JSON.stringify(history));
                if (activeJourney) {
                    localStorage.setItem('timemarkee_active_journey', JSON.stringify(activeJourney));
                } else {
                    localStorage.removeItem('timemarkee_active_journey');
                }
            } catch (e) {
                console.error("Storage save error:", e);
            }
        }

        // Audio Synth Engine for subtle sound feedback
        function playChime(type = 'mark') {
            if (!soundEnabled) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                const osc = ctx.createOscillator();
                const gain = ctx.createGain();
                
                osc.connect(gain);
                gain.connect(ctx.destination);

                if (type === 'mark') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                    osc.frequency.exponentialRampToValueAtTime(659.25, ctx.currentTime + 0.15);
                    gain.gain.setValueAtTime(0.12, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.25);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.25);
                } else if (type === 'finish') {
                    osc.type = 'sine';
                    osc.frequency.setValueAtTime(523.25, ctx.currentTime);
                    osc.frequency.setValueAtTime(659.25, ctx.currentTime + 0.12);
                    osc.frequency.setValueAtTime(783.99, ctx.currentTime + 0.24);
                    gain.gain.setValueAtTime(0.15, ctx.currentTime);
                    gain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + 0.4);
                    osc.start();
                    osc.stop(ctx.currentTime + 0.4);
                }
                setTimeout(() => { ctx.close(); }, 500);
            } catch(e) {
                console.log('Audio playback unavailable', e);
            }
        }

        function toggleSound() {
            soundEnabled = !soundEnabled;
            const container = document.getElementById('soundIconContainer');
            if (soundEnabled) {
                container.innerHTML = '<i data-lucide="volume-2" class="w-5 h-5"></i>';
                showToast('Audio feedback enabled', 'check-circle-2');
            } else {
                container.innerHTML = '<i data-lucide="volume-x" class="w-5 h-5"></i>';
                showToast('Audio muted', 'volume-x');
            }
            lucide.createIcons();
        }

        window.onload = function() {
            loadStorage();
            renderQuickStartPresets();
            renderPresetsList();
            populateAnalyticsRouteFilter();
            renderHistoryLogs();
            buildRollingWheelItems();
            startRealTimeClock();
            lucide.createIcons();

            // Auto-restore active journey if saved in localStorage
            const savedActive = localStorage.getItem('timemarkee_active_journey');
            if (savedActive) {
                try {
                    activeJourney = JSON.parse(savedActive);
                    if (activeJourney && activeJourney.steps) {
                        showActiveJourneyUI();
                    }
                } catch(e) {
                    console.error("Failed to restore active journey", e);
                }
            }
        };

        function buildRollingWheelItems() {
            const hoursWheel = document.getElementById('hoursWheel');
            const minutesWheel = document.getElementById('minutesWheel');

            if (!hoursWheel || !minutesWheel) return;

            let hHtml = '<div class="wheel-item opacity-0 select-none"></div>';
            for (let i = 0; i < 24; i++) {
                const val = i.toString().padStart(2, '0');
                hHtml += `<div class="wheel-item text-slate-700 dark:text-slate-300" onclick="scrollWheelTo('hours', ${i})">${val}</div>`;
            }
            hHtml += '<div class="wheel-item opacity-0 select-none"></div>';
            hoursWheel.innerHTML = hHtml;

            let mHtml = '<div class="wheel-item opacity-0 select-none"></div>';
            for (let i = 0; i < 60; i++) {
                const val = i.toString().padStart(2, '0');
                mHtml += `<div class="wheel-item text-slate-700 dark:text-slate-300" onclick="scrollWheelTo('minutes', ${i})">${val}</div>`;
            }
            mHtml += '<div class="wheel-item opacity-0 select-none"></div>';
            minutesWheel.innerHTML = mHtml;
        }

        function startRealTimeClock() {
            if (realTimeClockInterval) clearInterval(realTimeClockInterval);
            realTimeClockInterval = setInterval(() => {
                if (isAutoSyncingTime) {
                    syncPickerToCurrentTime();
                }
            }, 1000);
            syncPickerToCurrentTime();
        }

        function syncPickerToCurrentTime() {
            const now = new Date();
            selectedPickerHour = now.getHours();
            selectedPickerMinute = now.getMinutes();
            scrollWheelTo('hours', selectedPickerHour, false);
            scrollWheelTo('minutes', selectedPickerMinute, false);
            updateTimeSyncUI();
        }

        function scrollWheelTo(type, index, manualTrigger = true) {
            const container = document.getElementById(type === 'hours' ? 'hoursWheel' : 'minutesWheel');
            if (!container) return;
            const itemHeight = 36;
            container.scrollTo({ top: index * itemHeight, behavior: manualTrigger ? 'smooth' : 'auto' });
            
            if (type === 'hours') selectedPickerHour = index;
            if (type === 'minutes') selectedPickerMinute = index;

            if (manualTrigger) {
                isAutoSyncingTime = false;
                updateTimeSyncUI();
            }
        }

        let scrollTimeout = null;
        function handleWheelScroll(type) {
            const container = document.getElementById(type === 'hours' ? 'hoursWheel' : 'minutesWheel');
            if (!container) return;
            
            clearTimeout(scrollTimeout);
            scrollTimeout = setTimeout(() => {
                const itemHeight = 36;
                const index = Math.round(container.scrollTop / itemHeight);
                const maxIndex = type === 'hours' ? 23 : 59;
                const clampedIndex = Math.max(0, Math.min(index, maxIndex));

                if (type === 'hours') selectedPickerHour = clampedIndex;
                if (type === 'minutes') selectedPickerMinute = clampedIndex;

                const now = new Date();
                if (selectedPickerHour !== now.getHours() || selectedPickerMinute !== now.getMinutes()) {
                    isAutoSyncingTime = false;
                }
                updateTimeSyncUI();
            }, 80);
        }

        function resetToNow() {
            isAutoSyncingTime = true;
            syncPickerToCurrentTime();
            showToast('Time picker synced to live clock');
        }

        function updateTimeSyncUI() {
            const badgeContainer = document.getElementById('timeSyncBadge');
            const resetBtn = document.getElementById('resetNowBtn');
            if (!badgeContainer || !resetBtn) return;

            const hourStr = selectedPickerHour.toString().padStart(2, '0');
            const minStr = selectedPickerMinute.toString().padStart(2, '0');

            if (isAutoSyncingTime) {
                badgeContainer.innerHTML = `
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-emerald-100 dark:bg-emerald-950/80 text-emerald-700 dark:text-emerald-300">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
                        Real-time Sync (${hourStr}:${minStr})
                    </span>`;
                resetBtn.classList.add('hidden');
            } else {
                badgeContainer.innerHTML = `
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[11px] font-semibold bg-amber-100 dark:bg-amber-950/80 text-amber-700 dark:text-amber-300">
                        Custom Time: ${hourStr}:${minStr}
                    </span>`;
                resetBtn.classList.remove('hidden');
            }
            lucide.createIcons();
        }

        function loadStorage() {
            const savedPresets = localStorage.getItem('timemarkee_presets');
            presets = savedPresets ? JSON.parse(savedPresets) : DEFAULT_PRESETS;

            const savedHistory = localStorage.getItem('timemarkee_history');
            history = savedHistory ? JSON.parse(savedHistory) : [];

            // Sanitize history data to safeguard against date jumps
            let historyUpdated = false;
            history.forEach(h => {
                if (h.totalActualMins > 1000 || h.totalActualMins < 0) {
                    h.totalActualMins = Math.max(1, h.totalTargetMins || 1);
                    h.varianceMins = h.totalActualMins - (h.totalTargetMins || 0);
                    historyUpdated = true;
                }
            });
            if (historyUpdated) {
                saveStorage();
            }
        }

        function switchTab(tab) {
            document.getElementById('viewTracker').classList.add('hidden');
            document.getElementById('viewPresets').classList.add('hidden');
