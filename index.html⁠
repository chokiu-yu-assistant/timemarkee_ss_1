        function saveAmendedWaypoint() {
            if (!activeJourney) return;
            const idx = parseInt(document.getElementById('amendStepIndex').value);
            const dateStr = document.getElementById('amendStepDateInput').value;
            const timeStr = document.getElementById('amendStepTimeInput').value;
            const remarkStr = document.getElementById('amendStepRemarkInput').value.trim();

            if (isNaN(idx) || !dateStr || !timeStr) return;

            const updatedDt = new Date(`${dateStr}T${timeStr}:00`);
            activeJourney.steps[idx].markedAt = updatedDt.getTime();
            activeJourney.steps[idx].remark = remarkStr;

            let prevTimestamp = activeJourney.startTime;
            for (let i = 0; i < activeJourney.steps.length; i++) {
                if (i <= activeJourney.stepIndex && activeJourney.steps[i].markedAt) {
                    activeJourney.steps[i].durationSec = Math.max(0, Math.floor((activeJourney.steps[i].markedAt - prevTimestamp) / 1000));
                    prevTimestamp = activeJourney.steps[i].markedAt;
                }
            }

            saveStorage();
            updateActiveJourneyDisplay();
            closeAmendWaypointModal();
            showToast(`Updated waypoint time & remark`, 'check-circle-2');
        }

