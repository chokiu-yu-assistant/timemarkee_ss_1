                        <option value="Walk" ${transport === 'Walk' ? 'selected' : ''}>Walk</option>
                        <option value="Bus" ${transport === 'Bus' ? 'selected' : ''}>Bus</option>
                        <option value="MTR / Rail" ${transport === 'MTR / Rail' ? 'selected' : ''}>MTR / Rail</option>
                        <option value="Interchange" ${transport === 'Interchange' ? 'selected' : ''}>Interchange</option>
                    </select>
                    <input type="number" placeholder="Mins" value="${mins}" required min="1" max="300" class="wp-mins w-16 px-2 py-1.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-white dark:bg-slate-800 text-xs focus:outline-none text-center font-bold">
                    <button type="button" onclick="document.getElementById('${rowId}').remove()" class="p-1.5 text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg">
                        <i data-lucide="minus-circle" class="w-4 h-4"></i>
                    </button>
                </div>
                <input type="text" placeholder="Default Remark / Note (Optional)" value="${remark}" class="wp-remark w-full px-3 py-1 rounded-xl border border-slate-200/60 dark:border-slate-700/60 bg-white/70 dark:bg-slate-800/70 text-[11px] focus:outline-none">
            `;
            container.appendChild(div);
            lucide.createIcons();
        }

        function savePreset(e) {
            e.preventDefault();
            const id = document.getElementById('presetId').value || 'preset-' + Date.now();
            const name = document.getElementById('presetName').value;
            const origin = document.getElementById('presetOrigin').value;
            const destination = document.getElementById('presetDestination').value;
            const transitDetails = document.getElementById('presetTransitDetails').value;

            const rows = document.querySelectorAll('#waypointRows > div');
            const steps = [];
            rows.forEach(row => {
                const stepName = row.querySelector('.wp-name').value;
                const transportMode = row.querySelector('.wp-transport')?.value || 'Walk';
                const targetMins = parseInt(row.querySelector('.wp-mins').value) || 5;
                const stepRemark = row.querySelector('.wp-remark')?.value || '';
                if (stepName) {
                    steps.push({ name: stepName, targetMinutes: targetMins, transport: transportMode, remark: stepRemark });
                }
            });

            if (steps.length === 0) {
                showToast('Please add at least one waypoint step.', 'x-circle');
                return;
            }

            const existingIdx = presets.findIndex(p => p.id === id);
            const presetData = { id, name, origin, destination, transitDetails, steps };

            if (existingIdx >= 0) {
                presets[existingIdx] = presetData;
            } else {
                presets.push(presetData);
            }

            saveStorage();
            renderPresetsList();
            populateAnalyticsRouteFilter();
            closePresetModal();
            showToast('Preset saved successfully!');
        }

        function editPreset(id) {
            const p = presets.find(item => item.id === id);
            if (!p) return;

            document.getElementById('modalPresetTitle').innerText = 'Edit Journey Preset';
            document.getElementById('presetId').value = p.id;
            document.getElementById('presetName').value = p.name;
            document.getElementById('presetOrigin').value = p.origin;
            document.getElementById('presetDestination').value = p.destination;
            document.getElementById('presetTransitDetails').value = p.transitDetails || '';

            const rows = document.getElementById('waypointRows');
            rows.innerHTML = '';
            p.steps.forEach(s => addWaypointRow(s.name, s.targetMinutes, s.transport || 'Walk', s.remark || ''));

            document.getElementById('presetModal').classList.remove('hidden');
        }

        function deletePreset(id) {
            presets = presets.filter(p => p.id !== id);
            saveStorage();
            renderPresetsList();
            populateAnalyticsRouteFilter();
            showToast('Preset deleted', 'trash-2');
        }

        function populateAnalyticsRouteFilter() {
            const select = document.getElementById('analyticsRouteFilter');
            if (!select) return;
            const currentVal = select.value;
            select.innerHTML = '<option value="ALL">All Preset Routes</option>' + 
                presets.map(p => `<option value="${p.id}">${p.name}</option>`).join('');
            if (currentVal) select.value = currentVal;
        }

        function getFilteredHistory() {
            const routeFilter = document.getElementById('analyticsRouteFilter')?.value || 'ALL';
            const modeFilter = document.getElementById('analyticsModeFilter')?.value || 'ALL';

            return history.filter(h => {
                if (routeFilter !== 'ALL' && h.presetId !== routeFilter) return false;
                if (modeFilter !== 'ALL') {
                    const hasMode = h.steps && h.steps.some(s => (s.transport || '').toLowerCase().includes(modeFilter.toLowerCase()));
                    if (!hasMode) return false;
                }
                return true;
            });
        }

        function updateAnalytics() {
            const filtered = getFilteredHistory();
            document.getElementById('statTotalJourneys').innerText = filtered.length;
            
            if (filtered.length === 0) {
                document.getElementById('statAvgDuration').innerText = '0m';
                document.getElementById('statAvgDelay').innerText = '+0m';
                document.getElementById('statOnTimeRate').innerText = '100%';
                renderHistoryLogs();
                updateChart([]);
                return;
            }

            const totalActual = filtered.reduce((acc, h) => acc + h.totalActualMins, 0);
            const totalVariance = filtered.reduce((acc, h) => acc + h.varianceMins, 0);
            const onTimeCount = filtered.filter(h => h.varianceMins <= 2).length;

            const avgDur = Math.round(totalActual / filtered.length);
            const avgDelay = (totalVariance / filtered.length).toFixed(1);
            const onTimeRate = Math.round((onTimeCount / filtered.length) * 100);

            document.getElementById('statAvgDuration').innerText = `${avgDur}m`;
            document.getElementById('statAvgDelay').innerText = `${avgDelay >= 0 ? '+' : ''}${avgDelay}m`;
            document.getElementById('statOnTimeRate').innerText = `${onTimeRate}%`;

            renderHistoryLogs();
            updateChart(filtered);
        }

        function renderHistoryLogs() {
            const container = document.getElementById('historyLogsContainer');
            if (!container) return;

            const filtered = getFilteredHistory();

            if (filtered.length === 0) {
                container.innerHTML = `<p class="text-xs text-slate-400 text-center py-6">No matching journey records found.</p>`;
                return;
            }

            container.innerHTML = filtered.slice(0, 15).map(h => {
                const dateStr = new Date(h.date).toLocaleDateString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false });
                const delayText = h.varianceMins > 0 ? `+${h.varianceMins}m` : (h.varianceMins < 0 ? `${h.varianceMins}m` : `On time`);
                const colorClass = h.varianceMins > 0 ? 'text-amber-500' : 'text-emerald-500';

                return `
                    <div class="p-3.5 rounded-2xl bg-white dark:bg-slate-900 border border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
                        <div>
                            <h5 class="font-bold text-slate-800 dark:text-slate-200 text-sm">${h.presetName}</h5>
                            <p class="text-slate-400 mt-0.5">${dateStr} • ${h.steps.length} waypoints</p>
                        </div>
                        <div class="flex items-center space-x-3">
                            <div class="text-right">
                                <p class="font-bold font-mono text-sm">${h.totalActualMins} mins</p>
                                <p class="font-semibold ${colorClass}">${delayText}</p>
                            </div>
                            <div class="flex items-center space-x-1 pl-1 border-l border-slate-200 dark:border-slate-800">
                                <button onclick="openTripSummaryModalById('${h.id}')" title="View Summary & Export Text" class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-100 dark:hover:bg-slate-800 rounded-lg transition">
                                    <i data-lucide="file-text" class="w-4 h-4"></i>
                                </button>
                                <button onclick="deleteTripFromHistory('${h.id}')" title="Delete Log" class="p-1.5 text-slate-400 hover:text-rose-500 hover:bg-rose-50 dark:hover:bg-rose-950/40 rounded-lg transition">
                                    <i data-lucide="trash-2" class="w-4 h-4"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
            lucide.createIcons();
        }

        function openTripSummaryModalById(tripId) {
            const trip = history.find(h => h.id === tripId);
            if (trip) openTripSummaryModal(trip);
        }

        function openTripSummaryModal(trip) {
            activeSummaryTrip = trip;
            document.getElementById('summaryModalTitle').innerText = `${trip.presetName} - Journey Summary`;
            document.getElementById('summaryActualTime').innerText = `${trip.totalActualMins}m`;
            document.getElementById('summaryTargetTime').innerText = `${trip.totalTargetMins}m`;
            
            const varElem = document.getElementById('summaryVariance');
            const diffStr = trip.varianceMins > 0 ? `+${trip.varianceMins}m` : (trip.varianceMins < 0 ? `${trip.varianceMins}m` : '0m');
            varElem.innerText = diffStr;
            varElem.className = `text-xl font-extrabold ${trip.varianceMins > 0 ? 'text-amber-500' : 'text-emerald-500'}`;

            const startDt = new Date(trip.date);
            document.getElementById('summaryDateLine').innerText = `Departure Date: ${startDt.toLocaleDateString([], { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })}`;

            // Render waypoints breakdown
            const listContainer = document.getElementById('summaryWaypointsList');
            let prevTime = startDt.getTime();

            listContainer.innerHTML = trip.steps.map((step, idx) => {
                const markDt = step.markedAt ? new Date(step.markedAt) : new Date(prevTime);
                const markTimeStr = markDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                const durMins = step.durationSec ? Math.round(step.durationSec / 60) : step.targetMinutes;
                prevTime = markDt.getTime();

                const remarkTxt = step.remark ? `<p class="text-[11px] text-amber-600 dark:text-amber-400 italic mt-0.5">Note: ${step.remark}</p>` : '';

                return `
                    <div class="p-2.5 rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200/60 dark:border-slate-700/60 text-xs">
                        <div class="flex items-center justify-between">
                            <span class="font-bold text-slate-800 dark:text-slate-200">${idx + 1}. ${step.name} (${step.transport || 'Walk'})</span>
                            <span class="font-mono font-bold text-slate-700 dark:text-slate-300">${markTimeStr} (${durMins}m)</span>
                        </div>
                        ${remarkTxt}
                    </div>
                `;
            }).join('');

            // Generate exportable plain text representation
            let exportText = `=== COMMUTE JOURNEY SUMMARY (Timemarkee ${APP_VERSION}) ===\n`;
            exportText += `Route: ${trip.presetName}\n`;
            exportText += `Date: ${startDt.toLocaleDateString()} ${startDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}\n`;
            exportText += `Total Actual Duration: ${trip.totalActualMins} mins (Target: ${trip.totalTargetMins} mins, Variance: ${diffStr})\n`;
            exportText += `-----------------------------------\n`;
            exportText += `WAYPOINT BREAKDOWN:\n`;

            trip.steps.forEach((s, idx) => {
                const markDt = s.markedAt ? new Date(s.markedAt) : null;
                const timeStr = markDt ? markDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false }) : '--:--';
                const durMins = s.durationSec ? Math.round(s.durationSec / 60) : s.targetMinutes;
                exportText += `${idx + 1}. ${s.name} [${s.transport || 'Walk'}]\n`;
                exportText += `   Time: ${timeStr} | Leg Duration: ${durMins}m (Target: ${s.targetMinutes}m)\n`;
                if (s.remark) {
                    exportText += `   Remark: ${s.remark}\n`;
                }
            });
            exportText += `===================================\n`;

            const textArea = document.getElementById('summaryExportTextArea');
            if (textArea) textArea.value = exportText;

            document.getElementById('tripSummaryModal').classList.remove('hidden');
            lucide.createIcons();
        }

        function closeTripSummaryModal() {
            document.getElementById('tripSummaryModal').classList.add('hidden');
        }

        function copySummaryText() {
            const textArea = document.getElementById('summaryExportTextArea');
            if (!textArea) return;

            textArea.select();
            textArea.setSelectionRange(0, 99999);

            let success = false;
            try {
                success = document.execCommand('copy');
            } catch (err) {
                console.error("ExecCommand copy error", err);
            }

            if (success) {
                showToast('Summary copied to clipboard!', 'copy');
            } else {
                showToast('Text highlighted. Press Ctrl+C / Cmd+C to copy', 'file-text');
            }
        }

        function deleteTripFromHistory(tripId) {
            history = history.filter(h => h.id !== tripId);
            saveStorage();
            updateAnalytics();
            showToast('Trip log deleted', 'trash-2');
        }

        function initChart() {
            const canvas = document.getElementById('durationChart');
            if (!canvas || chartInstance) return;
            const ctx = canvas.getContext('2d');
            chartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: [],
                    datasets: [
                        {
                            label: 'Actual Commute (mins)',
                            data: [],
                            borderColor: '#6366f1',
                            backgroundColor: 'rgba(99, 102, 241, 0.1)',
                            borderWidth: 3,
                            fill: true,
                            tension: 0.3
                        },
                        {
                            label: 'Target Estimated (mins)',
                            data: [],
                            borderColor: '#94a3b8',
                            borderWidth: 2,
                            borderDash: [5, 5],
                            fill: false,
                            tension: 0.3
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { family: 'Plus Jakarta Sans', size: 11 } } }
                    },
                    scales: {
                        y: { beginAtZero: true, grid: { color: 'rgba(156, 163, 175, 0.1)' } },
                        x: { grid: { display: false } }
                    }
                }
            });
        }

        function updateChart(dataset = []) {
            initChart();
            if (!chartInstance) return;
            const recentHistory = [...dataset].reverse().slice(-7);

            chartInstance.data.labels = recentHistory.map(h => new Date(h.date).toLocaleDateString([], { month: 'numeric', day: 'numeric' }));
            chartInstance.data.datasets[0].data = recentHistory.map(h => h.totalActualMins);
            chartInstance.data.datasets[1].data = recentHistory.map(h => h.totalTargetMins);
            chartInstance.update();
        }

        function clearHistory() {
            history = [];
            saveStorage();
            updateAnalytics();
            showToast('History cleared');
        }
    </script>
</body>
</html>
