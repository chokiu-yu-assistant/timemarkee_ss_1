        function markNextStep() {
            if (!activeJourney) return;

            const currentIdx = activeJourney.stepIndex;
            const currentStep = activeJourney.steps[currentIdx];
            
            // Build logging timestamp using picker time overlaid onto journey date
            let logTime = Date.now();
            if (!isAutoSyncingTime) {
                const baseDt = currentIdx > 0 ? new Date(activeJourney.steps[currentIdx - 1].markedAt) : new Date(activeJourney.startTime);
                baseDt.setHours(selectedPickerHour, selectedPickerMinute, 0, 0);
                logTime = baseDt.getTime();

                // If picked time is earlier than previous timestamp, assume midnight boundary pass
                const prevTime = currentIdx > 0 ? activeJourney.steps[currentIdx - 1].markedAt : activeJourney.startTime;
                if (logTime < prevTime) {
                    logTime += 24 * 60 * 60 * 1000;
                }
            }

            const prevTimestamp = currentIdx > 0 ? activeJourney.steps[currentIdx - 1].markedAt : activeJourney.startTime;

            // Capture remark for this waypoint from input or preset
            const remarkInput = document.getElementById('nextStepRemarkInput');
            const userRemark = remarkInput ? remarkInput.value.trim() : '';

            activeJourney.steps[currentIdx].markedAt = logTime;
            activeJourney.steps[currentIdx].durationSec = Math.max(0, Math.floor((logTime - prevTimestamp) / 1000));
            if (userRemark) {
                activeJourney.steps[currentIdx].remark = userRemark;
            }

            activeJourney.stepIndex++;

            if (activeJourney.stepIndex >= activeJourney.steps.length) {
                // Trip Finished!
                const totalActualMins = Math.max(1, Math.round((logTime - activeJourney.startTime) / (60 * 1000)));
                const totalTargetMins = activeJourney.steps.reduce((acc, s) => acc + s.targetMinutes, 0);
                const varianceMins = totalActualMins - totalTargetMins;

                const completedRecord = {
                    id: activeJourney.id,
                    presetId: activeJourney.presetId,
                    presetName: activeJourney.presetName,
                    date: new Date(activeJourney.startTime).toISOString(),
                    totalActualMins: totalActualMins,
                    totalTargetMins: totalTargetMins,
                    varianceMins: varianceMins,
                    steps: activeJourney.steps
                };

                history.unshift(completedRecord);
                playChime('finish');

                activeSummaryTrip = completedRecord;
                
                activeJourney = null;
                saveStorage();
                
                document.getElementById('activeJourneyState').classList.add('hidden');
                document.getElementById('noActiveJourneyState').classList.remove('hidden');
                renderActiveJourneyBanner();
                updateAnalytics();

                openTripSummaryModal(completedRecord);
            } else {
                playChime('mark');
                saveStorage();
                
                // Clear next remark input for next step
                if (remarkInput) remarkInput.value = '';

                isAutoSyncingTime = true;
                syncPickerToCurrentTime();
                
                updateActiveJourneyDisplay();
                showToast(`Logged: ${currentStep.name}`, 'check-circle-2');
            }
        }

