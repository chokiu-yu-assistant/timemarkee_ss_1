        function saveJourneyStartTime() {
            if (!activeJourney) return;
            const dateStr = document.getElementById('journeyStartDateInput').value;
            const timeStr = document.getElementById('journeyStartTimeInput').value;
            if (!dateStr || !timeStr) return;

            const newStartDt = new Date(`${dateStr}T${timeStr}:00`);
            const newStartTimestamp = newStartDt.getTime();

            activeJourney.startTime = newStartTimestamp;

            let prevTimestamp = newStartTimestamp;
            for (let i = 0; i < activeJourney.stepIndex; i++) {
                if (activeJourney.steps[i].markedAt) {
                    if (activeJourney.steps[i].markedAt < prevTimestamp) {
                        activeJourney.steps[i].markedAt = prevTimestamp + 60 * 1000;
                    }
                    activeJourney.steps[i].durationSec = Math.max(0, Math.floor((activeJourney.steps[i].markedAt - prevTimestamp) / 1000));
                    prevTimestamp = activeJourney.steps[i].markedAt;
                }
            }

            saveStorage();
            updateActiveJourneyDisplay();
            closeEditStartTimeModal();
            showToast(`Start date & time updated`, 'calendar');
        }

