<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Timemarkee v1.0.0 - Commute & Trip Time Tracker</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <!-- Chart.js for Commute Analytics -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81',
                        },
                        accent: {
                            emerald: '#10b981',
                            amber: '#f59e0b',
                            rose: '#f43f5e',
                            cyan: '#06b6d4'
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                    }
                }
            }
        }
    </script>

    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            touch-action: manipulation;
            -webkit-tap-highlight-color: transparent;
        }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.75);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.5);
        }
        
        .dark .glass-panel {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.08);
        }

        .calm-glow {
            box-shadow: 0 4px 20px -2px rgba(99, 102, 241, 0.15);
        }

        /* Rolling Wheel Drum Picker Styling */
        .wheel-container {
            height: 108px;
            overflow-y: scroll;
            scroll-snap-type: y mandatory;
            -webkit-overflow-scrolling: touch;
            scrollbar-width: none;
            overscroll-behavior: contain;
        }
        .wheel-container::-webkit-scrollbar {
            display: none;
        }
        .wheel-item {
            height: 36px;
            scroll-snap-align: center;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: monospace;
            font-weight: 700;
            font-size: 1.125rem;
            cursor: pointer;
            transition: color 0.15s ease, opacity 0.15s ease;
        }

        /* Custom scrollbars */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: transparent;
        }
        ::-webkit-scrollbar-thumb {
            background: rgba(156, 163, 175, 0.4);
            border-radius: 9999px;
        }
    </style>
</head>
<body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors duration-200 selection:bg-brand-500 selection:text-white pb-12">

    <header class="sticky top-0 z-30 glass-panel border-b border-slate-200 dark:border-slate-800 px-4 py-3">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <div class="flex items-center space-x-2.5">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-brand-600 to-accent-cyan flex items-center justify-center text-white shadow-md shadow-brand-500/20">
                    <i data-lucide="timer" class="w-6 h-6"></i>
                </div>
                <div>
                    <div class="flex items-center gap-1.5">
                        <h1 class="font-extrabold text-lg leading-tight tracking-tight bg-gradient-to-r from-brand-600 to-indigo-600 dark:from-brand-400 dark:to-cyan-400 bg-clip-text text-transparent">
                            Timemarkee
                        </h1>
                        <span class="text-[10px] font-bold px-1.5 py-0.5 rounded-md bg-brand-100 dark:bg-brand-950 text-brand-600 dark:text-brand-300 border border-brand-200 dark:border-brand-800">v1.0</span>
                    </div>
                    <p class="text-xs text-slate-500 dark:text-slate-400 font-medium">Calm Commute & Trip ETA Marker</p>
                </div>
            </div>

            <div class="flex items-center space-x-2">
                <!-- Audio Feedback Toggle -->
                <button id="soundToggleBtn" onclick="toggleSound()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition" title="Toggle Audio Chimes">
                    <span id="soundIconContainer">
                        <i data-lucide="volume-2" class="w-5 h-5"></i>
                    </span>
                </button>

                <!-- Dark Mode Toggle -->
                <button onclick="toggleDarkMode()" class="p-2.5 rounded-xl bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 hover:bg-slate-200 dark:hover:bg-slate-700 transition">
                    <i data-lucide="moon" class="w-5 h-5 dark:hidden"></i>
                    <i data-lucide="sun" class="w-5 h-5 hidden dark:block"></i>
                </button>
            </div>
        </div>
    </header>

    <main class="flex-1 max-w-3xl w-full mx-auto px-4 pt-4 space-y-5">

        <!-- Tab Navigation Bar -->
        <nav class="flex p-1 bg-slate-200/80 dark:bg-slate-900 rounded-2xl text-sm font-semibold text-slate-600 dark:text-slate-400">
            <button id="tabTrackBtn" onclick="switchTab('tracker')" class="flex-1 py-2.5 rounded-xl flex items-center justify-center space-x-2 transition bg-white dark:bg-slate-800 text-brand-600 dark:text-brand-400 shadow-sm">
                <i data-lucide="navigation" class="w-4 h-4"></i>
                <span>Live Commute</span>
            </button>
            <button id="tabPresetsBtn" onclick="switchTab('presets')" class="flex-1 py-2.5 rounded-xl flex items-center justify-center space-x-2 transition hover:text-slate-900 dark:hover:text-slate-200">
                <i data-lucide="map-pin" class="w-4 h-4"></i>
                <span>Presets</span>
            </button>
            <button id="tabHistoryBtn" onclick="switchTab('history')" class="flex-1 py-2.5 rounded-xl flex items-center justify-center space-x-2 transition hover:text-slate-900 dark:hover:text-slate-200">
                <i data-lucide="bar-chart-3" class="w-4 h-4"></i>
                <span>Analytics</span>
            </button>
        </nav>

        <!-- Toast Notification Area -->
        <div id="toast" class="hidden fixed bottom-6 right-6 z-50 bg-slate-900 dark:bg-slate-100 text-white dark:text-slate-900 px-4 py-3 rounded-2xl shadow-xl flex items-center space-x-3 transition-all transform translate-y-2">
            <span id="toastIconContainer">
                <i data-lucide="check-circle-2" class="w-5 h-5 text-accent-emerald"></i>
            </span>
            <span id="toastMsg" class="text-sm font-medium">Action logged</span>
        </div>

        <section id="viewTracker" class="space-y-4">
            
            <div id="noActiveJourneyState" class="glass-panel p-6 rounded-3xl space-y-4 shadow-sm text-center">
                <!-- Active Journey In-Progress Banner -->
                <div id="activeJourneyBanner" class="hidden text-left p-4 rounded-2xl bg-gradient-to-r from-brand-600 to-indigo-600 text-white shadow-md space-y-3">
                    <div class="flex items-center justify-between">
                        <div class="flex items-center space-x-2">
                            <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            <span class="text-xs font-bold uppercase tracking-wider text-brand-100">Journey in Progress</span>
                        </div>
                        <span id="bannerProgressBadge" class="text-xs font-mono bg-white/20 px-2 py-0.5 rounded-md font-semibold">Step 1 of 5</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <div>
                            <h3 id="bannerRouteTitle" class="font-extrabold text-lg leading-tight">Home to Office</h3>
                            <p id="bannerCurrentStep" class="text-xs text-brand-100 mt-0.5">Next step: Walk to Bus Stop</p>
                        </div>
                        <div class="flex items-center space-x-2">
                            <button onclick="resumeJourney()" class="px-4 py-2 bg-white text-brand-600 font-bold rounded-xl text-xs hover:bg-brand-50 shadow-sm transition flex items-center space-x-1.5">
                                <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
                                <span>Resume Tracking</span>
                            </button>
                        </div>
                    </div>
                </div>

                <div class="w-16 h-16 bg-brand-50 dark:bg-slate-800/80 rounded-2xl mx-auto flex items-center justify-center text-brand-600 dark:text-brand-400">
                    <i data-lucide="play-circle" class="w-10 h-10"></i>
                </div>
                <div>
                    <h2 class="text-xl font-bold">Ready to Start a Journey?</h2>
                    <p class="text-sm text-slate-500 dark:text-slate-400 max-w-md mx-auto mt-1">Select a route below to confirm your departure time and start step-by-step ETA tracking.</p>
                </div>

                <!-- Quick Start Buttons -->
                <div id="quickStartPresetContainer" class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 text-left">
                    <!-- Populated dynamically -->
                </div>
            </div>

            <div id="activeJourneyState" class="hidden space-y-4">
                
                <!-- Main Status Card -->
                <div class="glass-panel p-6 rounded-3xl shadow-lg border-slate-200 dark:border-slate-800 relative overflow-hidden calm-glow">

                    <div class="flex items-center justify-between mb-4">
                        <div>
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-100 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300">
                                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                                Journey in Progress
                            </span>
                            <h2 id="activeRouteTitle" class="text-2xl font-extrabold mt-1 text-slate-900 dark:text-white">Morning Commute</h2>
                        </div>
                        <div class="flex items-center space-x-1.5">
                            <button onclick="returnToHome()" class="text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-600 dark:text-slate-300 bg-slate-100 dark:bg-slate-800 hover:bg-slate-200 dark:hover:bg-slate-700 transition flex items-center space-x-1">
                                <i data-lucide="arrow-left" class="w-3.5 h-3.5"></i>
                                <span>Home Page</span>
                            </button>
                            <button onclick="abortJourney()" class="text-xs font-semibold px-3 py-1.5 rounded-xl text-slate-400 hover:text-rose-600 hover:bg-rose-50 dark:hover:bg-rose-950/40 transition">
                                Cancel
                            </button>
                        </div>
                    </div>

                    <!-- Visual Progress Bar -->
                    <div class="space-y-1.5 mb-5">
                        <div class="flex justify-between text-xs font-semibold text-slate-500 dark:text-slate-400">
                            <span id="activeStepProgressText">Step 1 of 10</span>
                            <span id="activeStartClockTime" class="text-slate-400 font-medium">Started at 08:42</span>
                        </div>
                        <div class="w-full h-3 bg-slate-200 dark:bg-slate-800 rounded-full overflow-hidden p-0.5">
                            <div id="activeProgressBar" class="h-full bg-brand-600 rounded-full transition-all duration-500 w-1/4"></div>
                        </div>
                    </div>

                    <!-- Realtime Dynamic ETA & Next Waypoint Box -->
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-center bg-slate-100/70 dark:bg-slate-900/60 p-4 rounded-2xl border border-slate-200/50 dark:border-slate-800/50 mb-4">
                        <div>
                            <p class="text-xs text-slate-400 uppercase font-semibold tracking-wider">Start Time</p>
                            <div class="flex flex-col items-center justify-center gap-0.5 mt-0.5">
                                <div class="flex items-center gap-1">
                                    <p id="statStartTime" class="text-xl sm:text-2xl font-bold font-mono text-slate-800 dark:text-slate-200">08:42</p>
                                    <button onclick="openEditStartTimeModal()" title="Edit Start Date & Time" class="p-1 text-slate-400 hover:text-brand-600 transition rounded-lg hover:bg-slate-200 dark:hover:bg-slate-800">
                                        <i data-lucide="calendar" class="w-4 h-4"></i>
                                    </button>
                                </div>
                                <span id="statStartDateStr" class="text-[10px] font-semibold text-slate-400">Today</span>
                            </div>
                        </div>
                        
                        <div class="border-y sm:border-y-0 sm:border-x border-slate-200 dark:border-slate-800 py-2 sm:py-0">
                            <p class="text-xs text-brand-600 dark:text-brand-400 uppercase font-bold tracking-wider flex items-center justify-center gap-1">
                                <i data-lucide="compass" class="w-3.5 h-3.5"></i> Next Stop ETA
                            </p>
                            <p id="statNextStepEta" class="text-xl sm:text-2xl font-bold font-mono text-brand-600 dark:text-brand-400">08:45</p>
                            <p id="statNextStepName" class="text-[10px] font-semibold text-slate-500 dark:text-slate-400 truncate px-2">Walk to Bus Stop (+3m)</p>
                        </div>

                        <div>
                            <p class="text-xs text-slate-400 uppercase font-semibold tracking-wider">Overall Dynamic ETA</p>
                            <p id="statEta" class="text-xl sm:text-2xl font-bold font-mono text-slate-800 dark:text-slate-200">09:45</p>
                            <p id="statRemaining" class="text-[10px] font-semibold text-slate-400">Remaining: ~63m</p>
                        </div>
                    </div>

                    <!-- Real-Time Rolling Time Selector for Logging Step -->
                    <div class="p-4 rounded-2xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 space-y-3 mb-4">
                        <div class="flex items-center justify-between">
                            <span class="text-xs font-bold uppercase tracking-wider text-slate-500">Log Timestamp Picker</span>
                            <div id="timeSyncBadge">
                                <!-- Dynamic Sync Pill -->
                            </div>
                        </div>

                        <!-- Rolling Drum Wheel Controls -->
                        <div class="relative flex items-center justify-center gap-4 py-1">
                            <!-- Selected Highlight Banner -->
                            <div class="absolute inset-x-8 top-1/2 -translate-y-1/2 h-9 bg-brand-50 dark:bg-brand-950/60 rounded-xl border border-brand-200 dark:border-brand-800/80 pointer-events-none"></div>

                            <!-- Hours Wheel -->
                            <div class="w-20 text-center relative z-10">
                                <p class="text-[10px] uppercase font-bold text-slate-400 mb-1">Hours</p>
                                <div id="hoursWheel" onscroll="handleWheelScroll('hours')" class="wheel-container">
                                    <!-- Options injected dynamically -->
                                </div>
                            </div>

                            <span class="text-xl font-bold text-slate-400 relative z-10 mt-4">:</span>

                            <!-- Minutes Wheel -->
                            <div class="w-20 text-center relative z-10">
                                <p class="text-[10px] uppercase font-bold text-slate-400 mb-1">Mins</p>
                                <div id="minutesWheel" onscroll="handleWheelScroll('minutes')" class="wheel-container">
                                    <!-- Options injected dynamically -->
                                </div>
                            </div>
                        </div>

                        <!-- Reset Clock Action -->
                        <div class="flex items-center justify-between pt-1 text-xs">
                            <button id="resetNowBtn" onclick="resetToNow()" class="hidden px-2.5 py-1 rounded-lg text-brand-600 dark:text-brand-400 bg-brand-50 dark:bg-brand-900/40 hover:bg-brand-100 font-semibold transition flex items-center space-x-1">
                                <i data-lucide="refresh-cw" class="w-3 h-3"></i>
                                <span>Reset to Live Clock</span>
                            </button>
                        </div>
                    </div>

                    <!-- Next Waypoint Remark Field -->
                    <div class="mb-4">
                        <label for="nextStepRemarkInput" class="block text-xs font-bold text-slate-500 uppercase mb-1 flex items-center justify-between">
                            <span>Remark / Note for Next Waypoint <span class="text-[10px] text-slate-400 font-normal">(Optional)</span></span>
                            <span class="text-[10px] text-brand-600 dark:text-brand-400" id="remarkStatusTag"></span>
                        </label>
                        <input type="text" id="nextStepRemarkInput" placeholder="e.g. Bus delayed 2 mins, heavy rain at bus stop..." class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs focus:outline-none focus:ring-2 focus:ring-brand-500">
                    </div>

                    <!-- Main Action Button: Log / Mark Next Step -->
                    <div>
                        <button id="markStepBtn" onclick="markNextStep()" class="w-full py-3.5 px-5 bg-gradient-to-r from-brand-600 to-indigo-600 hover:from-brand-500 hover:to-indigo-500 text-white font-extrabold rounded-2xl shadow-lg shadow-brand-500/25 active:scale-[0.98] transition flex items-center justify-center space-x-2.5 text-base sm:text-lg">
                            <i data-lucide="check-circle-2" class="w-5 h-5 sm:w-6 sm:h-6"></i>
                            <span id="markBtnLabel">Log Step: Walk to Bus Stop</span>
                        </button>
                    </div>

                </div>

                <!-- Waypoints / Stop Logs Header -->
                <div class="glass-panel p-5 rounded-3xl space-y-3">
                    <h3 class="font-bold text-sm text-slate-500 uppercase tracking-wider">Journey Waypoints</h3>
                    <div id="activeWaypointsList" class="space-y-2">
                        <!-- Waypoints rendered dynamically -->
                    </div>
                </div>

            </div>
        </section>

        <section id="viewPresets" class="hidden space-y-4">
            <div class="flex items-center justify-between">
                <div>
                    <h2 class="text-xl font-bold">Commute Presets</h2>
                    <p class="text-xs text-slate-400">Configure standard routes, transport legs, and remarks.</p>
                </div>
                <button onclick="openCreatePresetModal()" class="px-4 py-2 bg-brand-600 hover:bg-brand-500 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center space-x-1.5">
                    <i data-lucide="plus" class="w-4 h-4"></i>
                    <span>New Preset</span>
                </button>
            </div>

            <div id="presetsContainer" class="space-y-3">
                <!-- Presets list rendered dynamically -->
            </div>
        </section>

        <section id="viewHistory" class="hidden space-y-4">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div>
                    <h2 class="text-xl font-bold">Commute Analytics</h2>
                    <p class="text-xs text-slate-400">Filter by route or transport category for targeted stats.</p>
                </div>
            </div>

            <!-- Analytics Filters -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 glass-panel p-3.5 rounded-2xl">
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Filter by Route Preset</label>
                    <select id="analyticsRouteFilter" onchange="updateAnalytics()" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-bold focus:outline-none">
                        <option value="ALL">All Preset Routes</option>
                        <!-- Populated dynamically -->
                    </select>
                </div>
                <div>
                    <label class="block text-[10px] font-bold text-slate-500 uppercase mb-1">Filter by Transport Mode</label>
                    <select id="analyticsModeFilter" onchange="updateAnalytics()" class="w-full px-3 py-2 rounded-xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-xs font-bold focus:outline-none">
                        <option value="ALL">All Transport Modes</option>
                        <option value="Walk">Walking Only</option>
                        <option value="Bus">Bus Only</option>
                        <option value="MTR / Rail">MTR / Rail Only</option>
                        <option value="Interchange">Station Interchange</option>
                    </select>
                </div>
            </div>

            <!-- Summary Stat Cards -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="glass-panel p-4 rounded-2xl text-center">
                    <p class="text-[10px] text-slate-400 font-bold uppercase">Total Trips</p>
                    <p id="statTotalJourneys" class="text-2xl font-extrabold mt-1 text-brand-600 dark:text-brand-400">0</p>
                </div>
                <div class="glass-panel p-4 rounded-2xl text-center">
                    <p class="text-[10px] text-slate-400 font-bold uppercase">Avg Duration</p>
                    <p id="statAvgDuration" class="text-2xl font-extrabold mt-1 text-slate-800 dark:text-slate-200">0m</p>
                </div>
                <div class="glass-panel p-4 rounded-2xl text-center">
                    <p class="text-[10px] text-slate-400 font-bold uppercase">Avg Delay</p>
                    <p id="statAvgDelay" class="text-2xl font-extrabold mt-1 text-amber-500">+0m</p>
                </div>
                <div class="glass-panel p-4 rounded-2xl text-center">
                    <p class="text-[10px] text-slate-400 font-bold uppercase">On-Time Rate</p>
                    <p id="statOnTimeRate" class="text-2xl font-extrabold mt-1 text-emerald-500">100%</p>
                </div>
            </div>

            <!-- Duration Trend Chart -->
            <div class="glass-panel p-5 rounded-3xl space-y-3">
                <h3 class="font-bold text-sm text-slate-700 dark:text-slate-300">Trip Duration History (mins)</h3>
                <div class="h-48 w-full">
                    <canvas id="durationChart"></canvas>
                </div>
            </div>

            <!-- Recent History Logs -->
            <div class="glass-panel p-5 rounded-3xl space-y-3">
                <div class="flex items-center justify-between">
                    <h3 class="font-bold text-sm text-slate-700 dark:text-slate-300">Completed Trips Log</h3>
                    <button onclick="clearHistory()" class="text-xs text-rose-500 hover:underline">Clear History</button>
                </div>
                <div id="historyLogsContainer" class="space-y-2">
                    <!-- History rows populated dynamically -->
                </div>
            </div>
        </section>

    </main>


    <!-- MODAL 0: START JOURNEY CONFIRMATION -->
    <div id="startConfirmModal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4 bg-slate-950/60 backdrop-blur-sm">
        <div class="bg-white dark:bg-slate-900 rounded-3xl max-w-sm w-full p-6 space-y-4 shadow-2xl border border-slate-200 dark:border-slate-800">
            <input type="hidden" id="startConfirmPresetId">
            <div class="flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <div class="w-8 h-8 rounded-lg bg-brand-100 dark:bg-brand-900/60 text-brand-600 dark:text-brand-300 flex items-center justify-center">
                        <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                    </div>
                    <h3 id="startConfirmPresetName" class="font-extrabold text-base">Confirm Journey Departure</h3>
                </div>
                <button onclick="closeStartConfirmModal()" class="text-slate-400 hover:text-slate-600 dark:hover:text-slate-200">
                    <i data-lucide="x" class="w-5 h-5"></i>
                </button>
            </div>

            <p class="text-xs text-slate-500 dark:text-slate-400">Verify or adjust your journey start date and time before beginning step tracking.</p>
            
            <div class="space-y-3">
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Start Date</label>
                    <input type="date" id="startConfirmDateInput" class="w-full px-3 py-2.5 rounded-xl border border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-800 text-sm font-semibold focus:outline-none focus:ring-2 focus:ring-brand-500">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-500 uppercase mb-1">Start Time (HH:MM)</label>
