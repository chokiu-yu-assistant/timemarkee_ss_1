            const step = activeJourney.steps[stepIdx];
            document.getElementById('amendStepIndex').value = stepIdx;
            document.getElementById('amendWaypointTitle').innerText = `Amend: ${step.name}`;
            
            const markDt = step.markedAt ? new Date(step.markedAt) : new Date();
            document.getElementById('amendStepDateInput').value = markDt.toISOString().split('T')[0];
            document.getElementById('amendStepTimeInput').value = markDt.toTimeString().substring(0, 5);
            document.getElementById('amendStepRemarkInput').value = step.remark || '';
            document.getElementById('amendWaypointModal').classList.remove('hidden');
