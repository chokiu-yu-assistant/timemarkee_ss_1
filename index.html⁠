        function updateActiveJourneyDisplay() {
            if (!activeJourney) return;

            const routeTitle = document.getElementById('activeRouteTitle');
            if (routeTitle) routeTitle.innerText = activeJourney.presetName;

            const totalSteps = activeJourney.steps.length;
            const currentIdx = activeJourney.stepIndex;
            const currentStep = activeJourney.steps[currentIdx];

            // Progress bar and text
            const stepProgressText = document.getElementById('activeStepProgressText');
            if (stepProgressText) {
                stepProgressText.innerText = `Step ${Math.min(currentIdx + 1, totalSteps)} of ${totalSteps}: ${currentStep ? currentStep.name : 'Finished'}`;
            }

            const progressBar = document.getElementById('activeProgressBar');
            if (progressBar) {
                const pct = Math.round(((currentIdx) / totalSteps) * 100);
                progressBar.style.width = `${Math.max(5, pct)}%`;
            }

            // Start time clock & Date display
            const startDt = new Date(activeJourney.startTime);
            const startStr = startDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
            const startDateStr = startDt.toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });
            
            const statStartTime = document.getElementById('statStartTime');
            if (statStartTime) statStartTime.innerText = startStr;

            const statStartDateStr = document.getElementById('statStartDateStr');
            if (statStartDateStr) statStartDateStr.innerText = startDateStr;

            const activeStartClockTime = document.getElementById('activeStartClockTime');
            if (activeStartClockTime) activeStartClockTime.innerText = `Started at ${startStr}`;

            // Calculate Dynamic ETA based on last marked timestamp + remaining target minutes
            const lastMarkedTimestamp = currentIdx > 0 ? activeJourney.steps[currentIdx - 1].markedAt : activeJourney.startTime;
            const remainingTargetMins = activeJourney.steps.slice(currentIdx).reduce((acc, s) => acc + s.targetMinutes, 0);

            const dynamicEtaDt = new Date(lastMarkedTimestamp + remainingTargetMins * 60 * 1000);
            const dynamicEtaStr = dynamicEtaDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
            
            const statEta = document.getElementById('statEta');
            if (statEta) statEta.innerText = dynamicEtaStr;

            const statRemaining = document.getElementById('statRemaining');
            if (statRemaining) statRemaining.innerText = `Remaining: ~${remainingTargetMins}m`;

            // Next Waypoint ETA specifically
            const statNextStepEta = document.getElementById('statNextStepEta');
            const statNextStepName = document.getElementById('statNextStepName');
            
            if (currentStep && statNextStepEta && statNextStepName) {
                const nextEtaTimestamp = lastMarkedTimestamp + currentStep.targetMinutes * 60 * 1000;
                const nextEtaDt = new Date(nextEtaTimestamp);
                statNextStepEta.innerText = nextEtaDt.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false });
                statNextStepName.innerText = `${currentStep.name} (+${currentStep.targetMinutes}m target)`;
            }

            // Pre-fill remark input if present in step
            const remarkInput = document.getElementById('nextStepRemarkInput');
            if (remarkInput && currentStep) {
                remarkInput.value = currentStep.remark || '';
            }

            // Mark button label
            const markBtnLabel = document.getElementById('markBtnLabel');
            if (markBtnLabel && currentStep) {
                markBtnLabel.innerText = currentIdx < totalSteps - 1 ? `Log Step: ${currentStep.name}` : `Finish Journey (${currentStep.name})`;
            }

            // Waypoints list rendering with remarks area
            const container = document.getElementById('activeWaypointsList');
            if (container) {
                container.innerHTML = activeJourney.steps.map((step, idx) => {
                    const isDone = idx < currentIdx;
                    const isCurrent = idx === currentIdx;
                    
                    let statusBadge = '';
                    let timeInfo = `<span class="text-xs text-slate-400 font-mono">Target: ${step.targetMinutes}m</span>`;

                    if (isDone) {
                        const markTimeStr = step.markedAt ? new Date(step.markedAt).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', hour12: false }) : '';
                        const durMins = Math.round((step.durationSec || 0) / 60);
                        const diff = durMins - step.targetMinutes;
                        const diffStr = diff > 0 ? `+${diff}m` : (diff < 0 ? `${diff}m` : 'on target');
                        const diffColor = diff > 0 ? 'text-amber-500' : 'text-emerald-500';

                        statusBadge = `<span class="w-6 h-6 rounded-full bg-emerald-100 dark:bg-emerald-950/80 text-emerald-600 dark:text-emerald-400 flex items-center justify-center text-xs font-bold"><i data-lucide="check" class="w-3.5 h-3.5"></i></span>`;
                        
                        timeInfo = `
                            <div class="flex items-center space-x-2 text-right">
                                <div>
                                    <p class="text-xs font-mono font-bold text-slate-800 dark:text-slate-200">${markTimeStr} (${durMins}m)</p>
                                    <p class="text-[10px] font-semibold ${diffColor}">${diffStr}</p>
                                </div>
                                <button onclick="openAmendWaypointModal(${idx})" title="Amend logged stop time & remark" class="p-1.5 text-slate-400 hover:text-brand-600 hover:bg-slate-200 dark:hover:bg-slate-800 rounded-lg transition">
                                    <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                                </button>
                            </div>
                        `;
                    } else if (isCurrent) {
                        statusBadge = `<span class="w-6 h-6 rounded-full bg-brand-600 text-white flex items-center justify-center text-xs font-bold animate-pulse">${idx + 1}</span>`;
                    } else {
                        statusBadge = `<span class="w-6 h-6 rounded-full bg-slate-200 dark:bg-slate-800 text-slate-400 flex items-center justify-center text-xs font-bold">${idx + 1}</span>`;
                    }

                    const bgClass = isCurrent 
                        ? 'bg-brand-50/80 dark:bg-brand-950/40 border-brand-300 dark:border-brand-800 shadow-sm' 
                        : (isDone ? 'bg-slate-50 dark:bg-slate-900/40 border-slate-200/60 dark:border-slate-800/60 opacity-85' : 'bg-slate-50/50 dark:bg-slate-900/20 border-slate-100 dark:border-slate-800/40');

                    const transportPill = step.transport ? `<span class="ml-2 text-[10px] px-2 py-0.5 rounded-md bg-slate-200/60 dark:bg-slate-800 text-slate-500 font-semibold">${step.transport}</span>` : '';
                    const remarkDisplay = step.remark ? `<p class="text-[11px] text-amber-600 dark:text-amber-400 italic mt-0.5"><i data-lucide="message-square" class="w-3 h-3 inline mr-1"></i>"${step.remark}"</p>` : '';

                    return `
                        <div class="p-3 rounded-2xl border ${bgClass} flex flex-col gap-1 transition">
                            <div class="flex items-center justify-between">
                                <div class="flex items-center space-x-3">
                                    ${statusBadge}
                                    <div>
                                        <div class="flex items-center">
                                            <p class="text-xs font-bold ${isCurrent ? 'text-brand-600 dark:text-brand-400' : 'text-slate-800 dark:text-slate-200'}">${step.name}</p>
                                            ${transportPill}
                                        </div>
                                        <p class="text-[10px] text-slate-400">Step ${idx + 1} • Target: ${step.targetMinutes} mins</p>
                                    </div>
                                </div>
                                ${timeInfo}
                            </div>
                            ${remarkDisplay}
                        </div>
                    `;
                }).join('');
                lucide.createIcons();
            }

            renderActiveJourneyBanner();
        }

